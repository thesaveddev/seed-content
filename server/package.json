    "bullmq": "^5.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.28.0",
    "sanitize-html": "^2.11.0",
    "stripe": "^14.14.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
