# ==========================================================
# Seed Environment Configuration
# ==========================================================
# Copy this file to .env and fill in your values.
#
# In development, everything works WITHOUT external services:
# - No MongoDB needed (in-memory database)
# - No Redis needed (in-process queue)
# - No OpenAI key needed (mock AI provider)
# - No SMTP needed (password resets logged to console)
#
# Just run: npm run dev:server && npm run dev:web
# ==========================================================

NODE_ENV=development
PORT=3001

# MongoDB (optional — in-memory used if not configured)
MONGODB_URI=mongodb://localhost:27017/seed

# Redis (optional — in-process queue used if not available)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# AI Provider: "mock" (default, no key needed) or "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-key-here

# File Storage: "local" (default) or "s3"
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Stripe (optional — direct upgrade in dev mode)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# SMTP for password reset emails (optional — logged to console if not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@seed.com

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
